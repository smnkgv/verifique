{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "verifique",
    "version": "0.1.0",
    "identifier": "dev.verifique.panel",
    "build": {
        "frontendDist": "ui"
    },
    "app": {
        "macOSPrivateApi": true,
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "panel",
                "title": "verifique",
                "url": "index.html",
                "width": 360,
                "height": 480,
                "visible": false,
                "decorations": false,
                "resizable": false,
                "transparent": true,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "shadow": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": false,
        "icon": [
            "icons/icon.png",
            "icons/icon.ico"
        ]
    }
}